# Attendance Management Backend Configuration

# HTTP Server Settings
ATTENDANCE_PORT=7080

# Database Connection
ATTENDANCE_DB=postgresql://postgres:password@localhost:5432/attendance_dev

# Keycloak Authentication
KEYCLOAK_ISSUER=http://localhost:8080/realms/attendance
KEYCLOAK_CLIENT_ID=attendance-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Logging
LOG_LEVEL=info

# Enabled Modules - comma separated list of module names
ENABLED_MODULES=organization,attendance,payroll,leave,user